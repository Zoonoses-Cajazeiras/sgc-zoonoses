# ==========================================
# SGC ZOONOSES - BACKEND
# Copie este arquivo para .env e preencha os valores.
# Nunca compartilhe ou envie o .env para o GitHub.
# ==========================================

# Banco de dados compartilhado - Neon (branch development)
DATABASE_URL="COLE_AQUI_A_URL_DA_BRANCH_DEVELOPMENT_DO_NEON"

# Autenticação - gere uma chave própria para cada integrante
JWT_SECRET="GERE_UMA_CHAVE_SEGURA_PARA_SUA_MAQUINA"

# E-mail - conta Gmail de desenvolvimento
EMAIL_USER="seu-email-de-desenvolvimento@gmail.com"
EMAIL_PASS="SENHA_DE_APP_DO_GMAIL"

# Armazenamento de imagens - Cloudinary
CLOUDINARY_CLOUD_NAME="SEU_CLOUD_NAME"
CLOUDINARY_API_KEY="SUA_API_KEY"
CLOUDINARY_API_SECRET="SEU_API_SECRET"

# Porta do backend
PORT=3000

# ==========================================
# OPCIONAL: PostgreSQL local com Docker
# Necessário somente se for utilizar o banco local.
# Não é necessário quando utilizar o Neon.
# ==========================================

POSTGRES_DB=sgc_zoonoses
POSTGRES_USER=sgc_user
POSTGRES_PASSWORD="DEFINA_UMA_SENHA_LOCAL_SEGURA"

# ==========================================
# OPCIONAL: criação manual do administrador
# Necessário somente ao executar prisma/create-admin.ts
# ==========================================

INITIAL_ADMIN_NAME=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
