generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Tabela de Campanhas
model Campaign {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   @default("Em andamento")
  schedule    String   @default("Todo sábado - 08h às 12h")
  location    String   @default("Ponto de vacinação do seu bairro")
  buttonText  String?
  createdAt   DateTime @default(now())
}

// Tabela de Estatísticas (Stats)
model ImpactStats {
  id         Int @id @default(1)
  vaccinated Int @default(4280)
  castrations Int @default(1130)
  tests      Int @default(870)
  sheltered  Int @default(340)
  citizens   Int @default(2600)
}